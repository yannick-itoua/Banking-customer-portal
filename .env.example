# Railway Environment Variables Example for Banking Customer Portal
# Copy this file to .env for local development

# =================
# BACKEND VARIABLES
# =================

# Database (Railway auto-provides DATABASE_URL in production)
DATABASE_URL=jdbc:postgresql://localhost:5432/banking_portal
DB_USERNAME=banking_user
DB_PASSWORD=banking_password

# JWT Configuration (REQUIRED - Generate secure values)
JWT_SECRET=your_secure_jwt_secret_base64_encoded_min_256_bits_replace_this
JWT_EXPIRATION=86400000

# Server Configuration
PORT=8080

# =================
# FRONTEND VARIABLES
# =================

# API URL (REQUIRED for production deployment)
# For Railway: Set this to your backend Railway domain
# For local development: Use localhost
NEXT_PUBLIC_API_URL=http://localhost:8080

# Port Configuration
PORT=8080
NODE_ENV=production

# =================
# RAILWAY DEPLOYMENT NOTES
# =================

# Backend Service Environment Variables:
# - DATABASE_URL: Auto-linked from PostgreSQL service
# - PORT: Auto-set by Railway
# - JWT_SECRET: Set manually (generate secure value)
# - JWT_EXPIRATION: Set manually (optional, defaults to 24h)

# Frontend Service Environment Variables:
# - NEXT_PUBLIC_API_URL: Set to backend Railway domain
# - PORT: Manually set to 8080

# Security Notes:
# - Never commit actual .env files to version control
# - Generate unique JWT_SECRET for each environment
# - Use Railway's secret management for sensitive values

# ===========================================
# APPLICATION CONFIGURATION
# ===========================================
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=docker

# ===========================================
# FRONTEND CONFIGURATION
# ===========================================
NEXT_PUBLIC_API_URL=http://localhost:8080

# ===========================================
# PRODUCTION SECURITY (Change for Production)
# ===========================================
# Generate new JWT secret: openssl rand -base64 64
# Use strong database passwords
# Enable HTTPS in production
# Set up proper CORS origins